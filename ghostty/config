# macOS terminal, same look as Windows Terminal (Solarized Osaka Vivid, 85% + blur)
theme = "Solarized Dark - Vivid"

background-opacity = 0.85
background-blur-radius = 20

font-family = "Maple Mono NF"
font-size = 13

cursor-style = block
macos-option-as-alt = left

window-padding-x = 8
window-padding-y = 8
