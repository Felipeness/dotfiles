# Git performance — avoid lock conflicts with Claude Code parallel ops
export GIT_OPTIONAL_LOCKS=0

# Holonomic Autopilot shortcuts
alias holonomic="cd ~/Desktop/Superlogica/bootcamp/holonomic-autopilot && git status"
alias holonomic-start="cd ~/Desktop/Superlogica/bootcamp/holonomic-autopilot && npx tsx start.ts"
alias holonomic-plan="code ~/Desktop/Superlogica/bootcamp/holonomic-autopilot/docs/superpowers/specs/2026-03-22-holonomic-v2-master-plan.md"

# Nexus CLI
export PATH="$HOME/.nexus/bin:$PATH"
